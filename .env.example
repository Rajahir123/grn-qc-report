# MONDAY_API_TOKEN: Your personal API token from monday.com (Profile -> Developers -> My Tokens)
MONDAY_API_TOKEN="YOUR_MONDAY_API_TOKEN"

# Admin_API_Key will act as secondary token if MONDAY_API_TOKEN is missing
Admin_API_Key="YOUR_ADMIN_API_KEY"

# Target_Board_ID is used to auto-populate the board ID using password login
Target_Board_ID="YOUR_TARGET_BOARD_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
